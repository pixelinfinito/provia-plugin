{
  "name": "provia-skills",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/build-skills.mjs --check && node scripts/check-contract.mjs",
    "validate": "node scripts/validate-workflow.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "evaluate": "node scripts/run-skill-evaluations.mjs",
    "release": "python3 scripts/build-release.py"
  }
}
